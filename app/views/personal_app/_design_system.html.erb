<%# Design-system CSS and JS from config.ds_base (ENV["DS_BASE"] in dev), from
    the pinned release's v/<sha>/ path with integrity attributes when
    config.ds_release names one. When `personal_app:ds:snapshot` has written
    public/ds/, each tag falls back to that local copy if the CDN fails (or a
    file fails its integrity check). -%>
<% fallback = personal_app_ds_fallback? -%>
    <link rel="preload" href="<%= personal_app_ds_url("fonts/inter-latin-wght.woff2") %>" as="font" type="font/woff2" crossorigin>
<% personal_app_ds_stylesheets.each do |css| -%>
<% if fallback -%>
    <link rel="stylesheet" href="<%= personal_app_ds_url(css) %>"<%= personal_app_ds_sri(css) %> onerror="<%= personal_app_ds_css_onerror(css) %>">
<% else -%>
    <link rel="stylesheet" href="<%= personal_app_ds_url(css) %>"<%= personal_app_ds_sri(css) %>>
<% end -%>
<% end -%>
<% personal_app_config.ds_sync_scripts.each do |name| -%>
    <script src="<%= personal_app_ds_url("#{name}.js") %>"<%= personal_app_ds_sri("#{name}.js") %>></script>
<% end -%>
<% if fallback -%>
    <%= personal_app_ds_sync_fallback_script %>
<% end -%>
    <%= personal_app_apps_tag %>
<% personal_app_config.ds_deferred_scripts.each do |name| -%>
<% if fallback -%>
    <script src="<%= personal_app_ds_url("#{name}.js") %>"<%= personal_app_ds_sri("#{name}.js") %> defer onerror="<%= personal_app_ds_deferred_onerror("#{name}.js") %>"></script>
<% else -%>
    <script src="<%= personal_app_ds_url("#{name}.js") %>"<%= personal_app_ds_sri("#{name}.js") %> defer></script>
<% end -%>
<% end -%>
