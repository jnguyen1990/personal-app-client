#!/usr/bin/env ruby
# The production deploy, one copy for every app (PLAT-43): libexec/personal-app-deploy.sh.
# This file is Ruby because Bundler's wrapper for a gem executable (`bundle exec
# personal-app-deploy`) always `load`s it as Ruby — v0.9.0 shipped the bash script here and the
# first deploy failed with a SyntaxError. It hands over to bash with the same environment.
script = File.expand_path("../libexec/personal-app-deploy.sh", __dir__)
exec("bash", script, *ARGV)
